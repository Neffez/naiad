# Home Assistant long-lived access token (generate in HA profile → Security → Long-lived tokens)
HA_TOKEN=your_ha_token_here

# Bcrypt hash of the app password
# Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
NAIAD_PASSWORD_HASH=

# Optional: password for the MQTT broker used by the statistics bridge (see the
# `mqtt:` section in config.yaml). Environment-managed like the other secrets.
# MQTT_PASSWORD=

# Optional overrides (defaults shown)
# NAIAD_CONFIG=/data/config.yaml
# NAIAD_DATA_DIR=/data
