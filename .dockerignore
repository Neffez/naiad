# Build context hygiene — keep the image lean and guard against an accidental `COPY . .`.
# Docs, design assets and screenshots are repo/GitHub-only and never belong in the image.
docs/
design/
# README.md is intentionally NOT ignored: the Dockerfile COPYs it in
# (pyproject's readme reference resolves to it). .dockerignore has no inline
# comments, so this note must stay on its own line.
*.md
!README.md

# VCS / CI / tooling
.git/
.github/
.gitignore
.pre-commit-config.yaml
.dockerignore

# Local dev artifacts
data/
.env
.env.*
!.env.example
**/.venv/
**/__pycache__/
**/*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Frontend deps/build caches (the image rebuilds these itself)
src/frontend/node_modules/
src/frontend/dist/
